# ===== Jev API =====
# Get your key at https://jevtypesafeai.com — keys look like jv_live_...
JEV_API_KEY=your_jev_key_here

# ===== Alpaca Paper Trading =====
# Get your keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here
ALPACA_PAPER=true

# ===== Opus 5.5 (Slow Brain) =====
# Point this at your Claude/Anthropic API key or any compatible endpoint
ANTHROPIC_API_KEY=your_anthropic_key_here

# ===== Telegram Bot =====
# Create a bot via @BotFather on Telegram, get the token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ===== Database =====
DATABASE_URL=sqlite:///trading_bot.db

# ===== Dashboard =====
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# ===== SOL quote preview / Phantom =====
# Configure locally; no wallet private key is needed for browser connection.
JUPITER_API_KEY=
